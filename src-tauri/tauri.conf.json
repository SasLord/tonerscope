{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TonerScope",
  "version": "0.3.0",
  "identifier": "com.tonerscope.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TonerScope",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": { "language": "ru-RU" },
      "nsis": {
        "languages": ["Russian"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": { "depends": [] },
      "appimage": { "bundleMediaFramework": false }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "shortDescription": "Network printer monitoring",
    "longDescription": "TonerScope monitors toner levels and status of network printers via SNMP",
    "category": "Utility"
  }
}
